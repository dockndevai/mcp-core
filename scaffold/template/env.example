# __SERVER_NAME__ — safe-by-default configuration (all optional; shown with their defaults).

# Access mode: read-only (default) | read-write | admin
__ENV_PREFIX___MODE=read-only

# Comma-separated __RESOURCE__ names the server may touch. Empty = all.
__ENV_PREFIX___ALLOWLIST=

# Comma-separated __RESOURCE__ names that may be read but never mutated or deleted.
__ENV_PREFIX___PROTECTED=

# Destructive deletes need this flag ON in addition to admin mode.
__ENV_PREFIX___ALLOW_DELETE=false

# Validate + log mutations without executing them.
__ENV_PREFIX___DRY_RUN=false

# JSON audit line to stderr for every guarded op (recommended ON).
__ENV_PREFIX___AUDIT_LOG=true
